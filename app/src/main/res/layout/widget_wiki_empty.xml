<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_empty_title"
        style="@style/WidgetMono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_empty_title"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_empty_body"
        style="@style/WidgetSerif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/widget_empty_body"
        android:textColor="@color/ink_secondary"
        android:textSize="13sp" />
</LinearLayout>
