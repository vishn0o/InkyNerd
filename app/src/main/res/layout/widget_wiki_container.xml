<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_clear"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Stack: a native swipeable deck (cards are pinned to a fixed size in WidgetCards so it
             stacks cleanly). Vertical swipes don't fight the launcher's horizontal paging. -->
        <StackView
            android:id="@+id/widget_stack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|start"
            android:loopViews="true"
            android:visibility="gone" />

        <!-- One at a time: the current card is drawn straight in here (no collection), so its
             taps are direct PendingIntents that can't land on a hidden neighbour. -->
        <FrameLayout
            android:id="@+id/widget_single"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/widget_empty"
            layout="@layout/widget_wiki_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- One at a time: "NEXT ›", a direct activity PendingIntent over the empty slot at the end
             of the card's footer. (Stack cards carry their own "›".) -->
        <TextView
            android:id="@+id/widget_next"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/widget_next_desc"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:minWidth="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_next_labeled"
            android:textSize="12sp" />

        <!-- First-placement gesture hints: shown for under a second, never intercept touches. -->
        <FrameLayout
            android:id="@+id/widget_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="noHideDescendants"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_hint_topic"
                style="@style/WidgetHint"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="36dp"
                android:text="@string/widget_hint_topic" />

            <TextView
                android:id="@+id/widget_hint_swipe"
                style="@style/WidgetHint"
                android:layout_gravity="center"
                android:text="@string/widget_hint_swipe" />

            <TextView
                android:id="@+id/widget_hint_next"
                style="@style/WidgetHint"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="72dp"
                android:layout_marginBottom="11dp"
                android:text="@string/widget_hint_next" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
