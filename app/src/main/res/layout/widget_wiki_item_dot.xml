<?xml version="1.0" encoding="utf-8"?>
<!-- Dot Matrix (Nothing-inspired) card. GENERATED by gen/layouts.py from the shared card template: every style has
     identical structure and metrics (padding 16/12/10/12, 32dp header, 24dp footer) so text sizing
     and space use are the same everywhere. Only RemoteViews-safe view types are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dot_dark"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <!-- Header: [tag][index or spacer][refresh][bookmark]. The tag is always top-left. -->
    <LinearLayout
        android:id="@+id/widget_item_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot_accent" />

        <TextView
            android:id="@+id/widget_item_category"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dot_dark"
            android:fontFamily="@font/doto_black"
            android:letterSpacing="0.06"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_preview_category"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/widget_item_category_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dot_dark"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:scaleType="matrix"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_item_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_refresh_desc"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/widget_refresh"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/widget_item_bookmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_bookmark"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bookmark_outline" />
    </LinearLayout>

    <!-- Fact: fills all remaining height. Android's auto-size picks the largest size (12–36sp)
         that fits the TextView's real bounds, so it fills any widget size, any style, in Stack too. -->
    <TextView
        android:id="@+id/widget_item_hook"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="36sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fadingEdgeLength="28dp"
        android:fontFamily="@font/doto_black"
        android:gravity="top|start"
        android:requiresFadingEdge="vertical"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="14"
        android:text="@string/widget_preview_hook"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/widget_item_hook_img"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:scaleType="fitStart"
        android:contentDescription="@null" />

    <!-- Dotted divider (ImageView: plain View is not allowed in widgets). -->
    <ImageView
        android:id="@+id/widget_item_rule"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_dot_rule_dark"
        android:importantForAccessibility="no" />

    <!-- Footer: [index (Dot/Almanac)][article title][slot under the container's › button]. -->
    <LinearLayout
        android:id="@+id/widget_item_footer"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_item_index"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/doto_black"
            android:textSize="20sp"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/widget_item_index_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:scaleType="matrix"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_item_title"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/doto_black"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/widget_item_title_img"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scaleType="matrix"
            android:contentDescription="@null" />

        <!-- In-card "›": visible in Stack mode (it moves with the front card). In One-at-a-time
             mode it stays invisible and reserves room for the container's "NEXT ›". -->
        <TextView
            android:id="@+id/widget_item_next"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_next_desc"
            android:gravity="center_vertical|end"
            android:includeFontPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:text="@string/widget_next"
            android:textSize="22sp"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
