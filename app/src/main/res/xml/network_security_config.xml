<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: every endpoint the app talks to (wikipedia.org, wikimedia.org) is TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
