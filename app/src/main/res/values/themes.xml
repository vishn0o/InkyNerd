<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.InkyNerd" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ink_background</item>
        <item name="android:colorBackground">@color/ink_background</item>
        <item name="android:statusBarColor">@color/ink_background</item>
        <item name="android:navigationBarColor">@color/ink_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.InkyNerd.Trampoline" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">true</item>
    </style>

    <!-- Widget text styles -->
    <style name="WidgetMono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="WidgetSerif">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <!-- Tiny gesture-hint pill shown briefly over the widget. -->
    <style name="WidgetHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_widget_hint</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
