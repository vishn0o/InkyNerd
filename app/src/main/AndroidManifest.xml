<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Stack sizes its deck per launcher (HyperOS fans cards far wider than Pixel), so the
         widget needs to see which app is the home screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".WikiInkApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkyNerd">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible trampoline for widget card / bookmark clicks. -->
        <!-- Exported because the launcher sends the widget's PendingIntents: on Android 17 a
             non-exported target fails with ActivityNotFoundException and taps are lost. It has no
             intent filter and only acts on its own known extras. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.InkyNerd.Trampoline" />

        <!-- Three size presets of the same widget: Standard 4×2 (default), Compact 3×2, Large 4×3. -->
        <receiver
            android:name=".widget.WikiWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Android 15+ drops explicit intents whose action no filter declares. -->
                <action android:name="com.wikiink.app.widget.ACTION_NEXT" />
                <action android:name="com.wikiink.app.widget.ACTION_TOPIC" />
                <action android:name="com.wikiink.app.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wiki_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.WikiWidgetProviderCompact"
            android:exported="false"
            android:label="@string/widget_label_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Android 15+ drops explicit intents whose action no filter declares. -->
                <action android:name="com.wikiink.app.widget.ACTION_NEXT" />
                <action android:name="com.wikiink.app.widget.ACTION_TOPIC" />
                <action android:name="com.wikiink.app.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wiki_widget_info_compact" />
        </receiver>
        <receiver
            android:name=".widget.WikiWidgetProviderLarge"
            android:exported="false"
            android:label="@string/widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Android 15+ drops explicit intents whose action no filter declares. -->
                <action android:name="com.wikiink.app.widget.ACTION_NEXT" />
                <action android:name="com.wikiink.app.widget.ACTION_TOPIC" />
                <action android:name="com.wikiink.app.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wiki_widget_info_large" />
        </receiver>
        <service
            android:name=".widget.WikiWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
